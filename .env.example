# ============================================
# AcaDesk 환경 변수
# ============================================
#
# 사용법:
# 1. 로컬 개발을 위해 이 파일을 .env.local로 복사:
#    cp .env.example .env.local
#
# 2. 프로덕션 배포:
#    - 호스팅 플랫폼(Vercel, Railway 등)에서 이 변수들을 설정하세요
#    - .env.local 또는 .env.production을 실제 값과 함께 커밋하지 마세요
#
# ============================================

# -------------------------
# Supabase 설정 (필수)
# -------------------------
# 다음에서 확인: Supabase 대시보드 > Project Settings > API
#
# 개발 환경: 개발/스테이징 프로젝트 사용
# 프로덕션: 프로덕션 프로젝트 사용 (개발과 분리)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -------------------------
# 애플리케이션 설정 (필수)
# -------------------------
# 애플리케이션의 전체 URL (프로토콜 포함, 후행 슬래시 없음)
#
# 로컬 개발:  http://localhost:3000
# 스테이징:   https://your-project.vercel.app (Vercel 도메인)
# 프로덕션:   https://your-custom-domain.com (커스텀 도메인)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------
# 환경 식별자 (필수)
# -------------------------
# 현재 환경: local, staging, production
NEXT_PUBLIC_ENV=local

# -------------------------
# 테넌트 설정 (단일 테넌트 모드용)
# -------------------------
# 키오스크 등 인증되지 않은 요청에 사용할 기본 테넌트 ID
# Supabase에서 tenants 테이블의 UUID 복사
# 예: NEXT_PUBLIC_DEFAULT_TENANT_ID=ec5ee235-7a1c-4570-b2be-5f6cbb8820e7
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# -------------------------
# Resend 이메일 서비스 (선택)
# -------------------------
# 이메일 발송을 위한 Resend API 키
# 다음에서 확인: https://resend.com/api-keys
# Development: Development API Key 사용
# Production: Production API Key 사용
#
# RESEND_API_KEY=re_...

# -------------------------
# Claude API (선택)
# -------------------------
# 리포트 코멘트 AI 초안 생성에 사용합니다.
# 미설정 시 AI 초안 버튼이 노출되지 않으며 나머지 기능은 정상 동작합니다.
# 다음에서 발급: https://platform.claude.com/
#
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------------
# 플랫폼 운영자 이메일 (선택)
# -------------------------
# 새 원장/학원 승인(/admin/approvals)을 수행할 수 있는 운영자 이메일 목록.
# 쉼표로 여러 개 지정 가능. 비워두면 아무도 승인할 수 없습니다.
#
# PLATFORM_ADMIN_EMAILS=owner@example.com,ops@example.com

# -------------------------
# Supabase Service Role Key (필수)
# -------------------------
# 전면 server-side + service_role 전환에 따라 필수로 필요합니다.
# 이 키는 RLS를 우회하며, 서버 사이드 코드(서버 액션, 라우트 핸들러)에서만 사용하세요.
# 절대로 클라이언트에 노출하거나 git에 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -------------------------
# SMS 발송 서비스 (선택)
# -------------------------
# 알리고 SMS (추천 - 한국, 가성비 최고)
# https://smartsms.aligo.in
# SMS 9원, LMS 27원 | 월 3,000원부터 시작 가능
# 발신번호 등록 필수 (휴대폰 인증 또는 사업자등록증)
ALIGO_API_KEY=your_api_key_here
ALIGO_USER_ID=your_user_id
ALIGO_SENDER=01012345678

# 기타 SMS 옵션 (선택사항)
# 옵션 1: NHN Cloud SMS
# https://www.nhncloud.com
# NHN_SMS_APP_KEY=your_app_key
# NHN_SMS_SECRET_KEY=your_secret_key
# NHN_SMS_SENDER=01012345678

# 옵션 2: Twilio (글로벌)
# https://www.twilio.com
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+821012345678

# 옵션 3: SENS (Naver Cloud Platform)
# https://www.ncloud.com
# NAVER_SENS_ACCESS_KEY=your_access_key
# NAVER_SENS_SECRET_KEY=your_secret_key
# NAVER_SENS_SERVICE_ID=your_service_id
# NAVER_SENS_SENDER=01012345678

# -------------------------
# 이메일 발송 서비스 (선택)
# -------------------------
# 옵션 1: SendGrid (하루 100통 무료)
# https://sendgrid.com
# SENDGRID_API_KEY=your_api_key
# SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# 옵션 2: Resend (Supabase Edge Functions 권장)
# https://resend.com
# RESEND_API_KEY=re_your_api_key

# 옵션 3: AWS SES (대량 발송)
# AWS 콘솔에서 설정
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# -------------------------
# 외부 API 시크릿 암호화 키 (필수 - 메시징 연동 사용 시)
# -------------------------
# 학원별 Solapi/NHN/Aligo API Secret을 DB에 저장할 때 사용하는 AES-256-GCM 키.
# 32바이트 랜덤 키를 base64로 인코딩해서 등록한다.
#
# 키 생성 명령:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 운영 환경에서는 절대로 키를 변경하지 말 것 (변경 시 기존 암호화 데이터 복호화 불가)
# ENCRYPTION_KEY=

# -------------------------
# Vercel Cron 인증 시크릿 (필수 - 예약 배치 발송 사용 시)
# -------------------------
# /api/cron/* 라우트를 보호하는 Bearer 토큰.
# Vercel 프로젝트 환경변수에 CRON_SECRET을 설정하면 Vercel Cron이 호출 시
# Authorization: Bearer <CRON_SECRET> 헤더를 자동으로 붙인다.
# 미설정 시 크론 라우트는 503을 반환한다 (fail-closed).
#
# 시크릿 생성 명령:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# -------------------------
# 테스트 전용 (커밋 금지, 로컬에서만)
# -------------------------
# e2e 스모크 (pnpm test:e2e) — 테스트 전용 테넌트 계정 권장, 미설정 시 skip
# E2E_EMAIL=
# E2E_PASSWORD=
#
# 테넌트 격리 통합 테스트 (pnpm test:integration) — 반드시 로컬 Supabase만!
# 기동: supabase start -x storage-api,imgproxy (storage는 구 CLI와 볼륨 불일치로 제외)
# 키: `supabase status`의 Secret key (sb_secret_...) 사용. 미설정 시 skip
# 최초 1회: 로컬 DB에 프로덕션 스키마 덤프 주입 + ref_roles 시드 필요
#   (마이그레이션 히스토리에 베이스 스키마가 없어 db reset만으로는 부트스트랩 불가 — TODO 백로그 참조)
# TEST_SUPABASE_URL=http://127.0.0.1:55321
# TEST_SUPABASE_SERVICE_ROLE_KEY=

# -------------------------
# 에러 모니터링 (Sentry) — 프로덕션 필수 권장
# -------------------------
# DSN이 설정되면 서버/엣지/클라이언트 에러 수집이 자동 활성화된다.
# 미설정 시 Sentry는 완전 no-op (로컬 개발 기본 상태).
# DSN 확인: https://sentry.io/settings/projects/
#
# 소스맵 업로드(선택): CI/Vercel 빌드 env에 SENTRY_AUTH_TOKEN, SENTRY_ORG,
# SENTRY_PROJECT를 추가하면 빌드 시 소스맵이 업로드된다. 없으면 건너뜀.
#
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -------------------------
# 개발 환경 체크리스트
# -------------------------
# 개발 시작 전:
# ✓ 이 파일을 .env.local로 복사
# ✓ 모든 플레이스홀더 값을 실제 Supabase 크레덴셜로 변경
# ✓ Supabase 프로젝트가 생성되고 접근 가능한지 확인
# ✓ 마이그레이션 실행: SETUP.md 참조

# -------------------------
# 프로덕션 배포 체크리스트
# -------------------------
# 프로덕션 배포 전:
# ✓ PRODUCTION Supabase 프로젝트 크레덴셜 사용 (개발과 분리)
# ✓ NEXT_PUBLIC_APP_URL이 HTTPS 프로토콜 사용
# ✓ Supabase RLS 정책이 활성화되고 테스트됨
# ✓ 환경 변수가 호스팅 플랫폼 대시보드에 설정됨
# ✓ 도메인이 SSL 인증서와 함께 올바르게 구성됨
# ✓ 모든 인증 플로우를 프로덕션 환경에서 테스트
# ✓ 절대로 .env.production을 실제 값과 함께 커밋하지 마세요

# -------------------------
# 보안 주의사항
# -------------------------
# - NEXT_PUBLIC_* 변수는 브라우저에 노출됩니다
# - Supabase anon key는 노출되어도 안전합니다 (RLS로 보호됨)
# - 모든 데이터 접근은 반드시 RLS 정책으로 보호되어야 합니다
# - Service role key(사용 시)는 서버 사이드 코드에서만 사용
# - 개발/스테이징/프로덕션에 항상 별도의 Supabase 프로젝트 사용
